# Copy to .env (never commit it). The server reads .env from its working
# directory only (not parent directories), or the file given with --env-file.
# Variables already set in the environment take precedence.

# Required for every data tool. A free key is enough for the free tables and
# the premium samples: https://data.nasdaq.com/sign-up
NASDAQ_DATA_LINK_API_KEY=your_api_key_here

# Optional settings (the values shown are the defaults).

# Comma-separated toolsets to enable, or "all". "core" is always on.
# Toolsets: core, sql, nasdaq, equities, funds, world_bank, macro, commodities,
# crypto, housing, carbon
# NDL_TOOLSETS=all

# Log level on stderr: DEBUG, INFO, WARNING, ERROR or CRITICAL
# NDL_LOG_LEVEL=WARNING

# Rows returned when a tool call gives no limit (1-1000, at most NDL_MAX_LIMIT)
# NDL_DEFAULT_LIMIT=100
# Upper bound for any limit argument (1-1000)
# NDL_MAX_LIMIT=1000
# Byte budget for one tool result before rows are dropped (5000-5000000)
# NDL_MAX_RESPONSE_BYTES=100000

# Concurrent API requests: free keys allow 1, premium keys up to 5
# NDL_MAX_CONCURRENCY=1
# Retries for rate limits and transient errors (0-10)
# NDL_MAX_RETRIES=3
# Per-request timeout in seconds (>= 1)
# NDL_TIMEOUT_SECONDS=30
# Time limit for a whole tool call, retries included, in seconds (>= 5)
# NDL_TOOL_DEADLINE_SECONDS=50
# Time limit for a DataLink SQL statement before it is cancelled (>= 5)
# NDL_SQL_TIMEOUT_SECONDS=50
# Cache lifetimes in seconds (0 disables)
# NDL_CACHE_TTL_SECONDS=300
# NDL_METADATA_CACHE_TTL_SECONDS=21600

# HTTP transports only (--transport streamable-http or sse).
# Bearer token clients must send; required to bind anything but loopback.
# NDL_HTTP_TOKEN=
# Comma-separated host names accepted in the Host header, e.g. behind a proxy.
# NDL_ALLOWED_HOSTS=

# NDL_BASE_URL (default https://data.nasdaq.com) is ignored in .env files:
# it decides where the API key is sent, so set it in the real environment.
